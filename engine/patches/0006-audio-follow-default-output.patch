# Sound follows the Mac's default output while a game runs, instead of staying on the device it started on.
--- a/dlls/winecoreaudio.drv/coreaudio.c	2026-11-05 01:33:32
+++ b/dlls/winecoreaudio.drv/coreaudio.c	2026-11-05 01:33:32
@@ -85,6 +85,7 @@
     AudioConverterRef converter;
     AudioStreamBasicDescription dev_desc; /* audio unit format, not necessarily the same as fmt */
     AudioDeviceID dev_id;
+    BOOL follows_default; /* Cellar: plays on whatever the Mac's default output is */
 
